# Generated for local Docker by bun run local:up. Never use service_role in either app.
# Values come from supabase start / supabase status -o env, not a hosted project.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
WEB_ORIGIN=http://localhost:5173
# Optional API listen port; default 3000. Web Docker port is 8080.
PORT=3000
# Optional web-server reverse-proxy target; Compose overrides it to http://api:3000.
API_INTERNAL_URL=http://localhost:3000
# TEST_JWT_SECRET is read only by tests from supabase status for real expiry proof.
# DOCKER_HOST (optional) is inherited by Docker, Supabase CLI and scripts.
