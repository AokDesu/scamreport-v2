{
  "name": "scamreport-v2",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --parallel --filter '@scamreport/*' dev",
    "typecheck": "tsc --noEmit",
    "build": "bun run --filter @scamreport/web build",
    "test": "bun scripts/test.ts",
    "test:api": "bun test apps/api/tests",
    "test:web": "bun run --cwd apps/web test",
    "local:up": "bun scripts/local-up.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
